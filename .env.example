# --- Ambiente ---
ENVIRONMENT=homolog

# --- Joomla ---
JOOMLA_PORT=9082

# --- Joomla App ---
JOOMLA_DB_HOST=coletamir_db
# Apelido DNS extra do banco neste ambiente (homolog/prod no mesmo servidor).
JOOMLA_DB_ALIAS=coletamir_db_homolog
JOOMLA_DB_USER=coletamir_joomla_user
JOOMLA_DB_PASSWORD=
JOOMLA_DB_NAME=coletamir_joomla_db
JOOMLA_SITE_NAME=COLETA-MIR
JOOMLA_ADMIN_USER="COLETAMIR USER"
JOOMLA_ADMIN_USERNAME=sinapir
JOOMLA_ADMIN_PASSWORD=
JOOMLA_ADMIN_EMAIL=admin@example.org
VIRTUAL_HOST=homologacao.coletamir.sinapir.org.br
VIRTUAL_PORT=80
LETSENCRYPT_HOST=homologacao.coletamir.sinapir.org.br

# --- GOV.BR OpenID Connect ---
OIDC_PROVIDER_PROFILE=govbr_staging
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PUBLIC_BASE_URL=https://homologacao.coletamir.sinapir.org.br
OIDC_REDIRECT_URI_MODE=component_route

# --- Banco de Dados ---
DB_PORT=43306
DB_DATA_SERVER="/data/volumes/${JOOMLA_DB_NAME}-${ENVIRONMENT}"
MYSQL_DATABASE=coletamir_joomla_db
MYSQL_USER=coletamir_joomla_user
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- API de envio de e-mails SINAPIR ---
SINAPIRMAIL_URL_BASE_API=https://casa-contato-email-api-28178688977.southamerica-east1.run.app
SINAPIRMAIL_API_TOKEN=token_aqui
SINAPIRMAIL_FROM_ADDRESS=noreply@igualdaderacial.gov.br