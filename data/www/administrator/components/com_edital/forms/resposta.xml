<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Comedital\Component\Edital\Administrator\Field">
  <fieldset>
    <field name="id" type="text" readonly="true" class="readonly" default="0" description="JGLOBAL_FIELD_ID_DESC"/>
    <field name="state" default="1" type="list" label="JSTATUS" description="JFIELD_PUBLISHED_DESC" class="inputbox" size="1">
      <option value="1">JPUBLISHED</option>
      <option value="0">JUNPUBLISHED</option>
      <option value="2">JARCHIVED</option>
      <option value="-2">JTRASHED</option>
    </field>
    <field name="ordering"/>
    <field name="checked_out" type="hidden" filter="unset"/>
    <field name="checked_out_time" type="hidden" filter="unset"/>
    <field name="created_by" type="createdby" default="0" label="JGLOBAL_FIELD_CREATED_BY_LABEL" description="JGLOBAL_FIELD_CREATED_BY_DESC" hidden="true" hint="COM_EDITAL_FORM_LBL_RESPOSTA_CREATED_BY"/>
    <field name="modified_by" type="modifiedby" default="0" label="JGLOBAL_FIELD_MODIFIED_BY_LABEL" description="JGLOBAL_FIELD_MODIFIED_BY_DESC" hidden="true" hint="COM_EDITAL_FORM_LBL_RESPOSTA_MODIFIED_BY"/>
    <field name="co_pergunta" type="foreignkey" label="COM_EDITAL_FORM_LBL_RESPOSTA_CO_PERGUNTA" description="COM_EDITAL_FORM_DESC_RESPOSTA_CO_PERGUNTA" default="" input_type="list" table="#__tb_pergunta" key_field="id" translate="true" value_multiple="1" value_field_multiple="ds_titulo,co_edital" value_field="fk_value" separator=" " required="true"/>
    <field name="co_adesao" type="foreignkey" label="COM_EDITAL_FORM_LBL_RESPOSTA_CO_ADESAO" description="COM_EDITAL_FORM_DESC_RESPOSTA_CO_ADESAO" default="" input_type="list" table="#__tb_adesao" key_field="id" translate="true" value_multiple="1" value_field_multiple="co_edital,no_oficial" value_field="fk_value" separator=" " required="true"/>
    <field name="ds_resposta" filter="raw" type="textarea" label="COM_EDITAL_FORM_LBL_RESPOSTA_DS_RESPOSTA" description="COM_EDITAL_FORM_DESC_RESPOSTA_DS_RESPOSTA" hint="COM_EDITAL_FORM_LBL_RESPOSTA_DS_RESPOSTA"/>
    <field name="dt_criacao" type="timecreated" label="COM_EDITAL_FORM_LBL_RESPOSTA_DT_CRIACAO" description="COM_EDITAL_FORM_DESC_RESPOSTA_DT_CRIACAO" hint="COM_EDITAL_FORM_LBL_RESPOSTA_DT_CRIACAO"/>
    <field name="dt_alterado" type="timeupdated" label="COM_EDITAL_FORM_LBL_RESPOSTA_DT_ALTERADO" description="COM_EDITAL_FORM_DESC_RESPOSTA_DT_ALTERADO" hint="COM_EDITAL_FORM_LBL_RESPOSTA_DT_ALTERADO"/>
    <field name="ds_comentario_avaliador" editor="|" buttons="false" filter="\Joomla\CMS\Component\ComponentHelper::filterText" type="editor" label="COM_EDITAL_FORM_LBL_RESPOSTA_DS_COMENTARIO_AVALIADOR" description="COM_EDITAL_FORM_DESC_RESPOSTA_DS_COMENTARIO_AVALIADOR" hint="COM_EDITAL_FORM_LBL_RESPOSTA_DS_COMENTARIO_AVALIADOR"/>
    <field name="st_situacao" type="list" label="COM_EDITAL_FORM_LBL_RESPOSTA_ST_SITUACAO" description="COM_EDITAL_FORM_DESC_RESPOSTA_ST_SITUACAO" hint="COM_EDITAL_FORM_LBL_RESPOSTA_ST_SITUACAO">
      <option value="aprovada">COM_EDITAL_RESPOSTAS_ST_SITUACAO_OPTION_APROVADA</option>
      <option value="reprovada">COM_EDITAL_RESPOSTAS_ST_SITUACAO_OPTION_REPROVADA</option>
      <option value="pendente">COM_EDITAL_RESPOSTAS_ST_SITUACAO_OPTION_PENDENTE</option>
    </field>
    <field name="version_note" type="text" label="JGLOBAL_FIELD_VERSION_NOTE_LABEL" description="JGLOBAL_FIELD_VERSION_NOTE_DESC" class="inputbox" size="45" labelclass="control-label"/>
  </fieldset>
</form>
