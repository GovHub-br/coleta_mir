<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" description="COM_EDITAL_SEARCH_FILTER_SUBMIT"
               label="COM_USERS_FILTER_SEARCH_DESC"
               class="js-stools-search-string" />

        <field name="state"
               type="status"
               label="COM_EDITAL_FILTER_STATE"
               description="COM_EDITAL_FILTER_STATE_DESC"
               onchange="this.form.submit();"
        >
            <option value="">JOPTION_SELECT_PUBLISHED</option>
        </field>

        <field
            name="tp_esfera_governamental"
            label="COM_EDITAL_FORM_LBL_ADESAO_TP_ESFERA_GOVERNAMENTAL"
            type="list"
            onchange="this.form.submit();"
            multiple="true"
            class="js-select-submit-on-change"
            layout="joomla.form.field.list-fancy-select"
            hint="COM_EDITAL_ADESOES_TP_ESFERA_GOVERNAMENTAL_FILTER"
        >
            <option value="estadual">COM_EDITAL_ADESOES_TP_ESFERA_GOVERNAMENTAL_OPTION_ESTADUAL</option>
            <option value="municipal">COM_EDITAL_ADESOES_TP_ESFERA_GOVERNAMENTAL_OPTION_MUNICIPAL</option>
            <option value="consorcio">COM_EDITAL_ADESOES_TP_ESFERA_GOVERNAMENTAL_OPTION_CONSORCIO</option>
        </field>
        <field
            name="co_edital"
            type="sql"
            label="COM_EDITAL_FORM_LBL_ADESAO_CO_EDITAL"
            query="SELECT `id` AS `id`, `no_edital` AS val FROM `#__tb_edital`"
            key_field="id"
            value_field="val"
            class="inputbox"
            onchange="this.form.submit()"
            translate="true"
            layout="joomla.form.field.list-fancy-select"
            multiple="true"
            hint="COM_EDITAL_ADESOES_CO_EDITAL_FILTER"
        />
        <field
            name="st_adesao"
            type="list"
            label="COM_EDITAL_FORM_LBL_ADESAO_ST_ADESAO"
            onchange="this.form.submit();"
            multiple="true"
            class="js-select-submit-on-change"
            layout="joomla.form.field.list-fancy-select"
            hint="COM_EDITAL_ADESOES_ST_ADESAO_FILTER"
        >
            <option value="pendente">COM_EDITAL_ADESOES_ST_ADESAO_OPTION_PENDENTE</option>
            <option value="rascunho">COM_EDITAL_ADESOES_ST_ADESAO_OPTION_RASCUNHO</option>
            <option value="avaliado">COM_EDITAL_ADESOES_ST_ADESAO_OPTION_AVALIADA</option>
            <option value="recusado">COM_EDITAL_ADESOES_ST_ADESAO_OPTION_RECUSADA</option>
            <option value="recurso">COM_EDITAL_ADESOES_ST_ADESAO_OPTION_RECURSO</option>
            <option value="aprovado">COM_EDITAL_ADESOES_ST_ADESAO_OPTION_APROVADA</option>
            <option value="indeferido">COM_EDITAL_ADESOES_ST_ADESAO_OPTION_INDEFERIDO</option>
            <option value="deferido">COM_EDITAL_ADESOES_ST_ADESAO_OPTION_DEFERIDO</option>
            <option value="assinatura">COM_EDITAL_ADESOES_ST_ADESAO_OPTION_ASSINATURA</option>
            <option value="publicacao">COM_EDITAL_ADESOES_ST_ADESAO_OPTION_PUBLICACAO</option>
            <option value="complemento">COM_EDITAL_ADESOES_ST_ADESAO_OPTION_COMPLEMENTO</option>
            <option value="complementacao">COM_EDITAL_ADESOES_ST_ADESAO_OPTION_COMPLEMENTACAO</option>
        </field>
        <field
            name="ds_modalidade"
            type="list"
            label="COM_EDITAL_FORM_LBL_ADESAO_DS_MODALIDADE"
            onchange="this.form.submit();"
            multiple="true"
            class="js-select-submit-on-change"
            layout="joomla.form.field.list-fancy-select"
            hint="COM_EDITAL_ADESOES_DS_MODALIDADE_FILTER"
        >
            <option value="__empty__">COM_EDITAL_ADESOES_DS_MODALIDADE_OPTION_VAZIA</option>
            <option value="basica">COM_EDITAL_ADESOES_DS_MODALIDADE_OPTION_BASICA</option>
            <option value="intermediaria">COM_EDITAL_ADESOES_DS_MODALIDADE_OPTION_INTERMEDIARIA</option>
            <option value="plena">COM_EDITAL_ADESOES_DS_MODALIDADE_OPTION_PLENA</option>
        </field>
        <field
            name="vinculada"
            type="list"
            label="COM_EDITAL_ADESOES_VINCULADA"
            onchange="this.form.submit();"
        >
            <option value="">COM_EDITAL_ADESOES_VINCULADA_FILTER</option>
            <option value="1">COM_EDITAL_ADESOES_VINCULADA_OPTION_SIM</option>
            <option value="0">COM_EDITAL_ADESOES_VINCULADA_OPTION_NAO</option>
        </field>
        <field
            name="sg_estado"
            type="sql"
            label="COM_EDITAL_ADESOES_SG_ESTADO"
            query="SELECT `sg_estado` AS `sg`, `no_estado` AS val FROM `#__tb_estado` ORDER BY `no_estado` ASC"
            key_field="sg"
            value_field="val"
            class="inputbox"
            onchange="this.form.submit();"
            layout="joomla.form.field.list-fancy-select"
            multiple="true"
            hint="COM_EDITAL_ADESOES_SG_ESTADO_FILTER"
        />
        <field
            name="ds_municipios"
            type="sql"
            label="COM_EDITAL_ADESOES_DS_MUNICIPIOS"
            query="SELECT m.`co_ibge` AS `co`, CONCAT(m.`no_municipio`, ' - ', e.`sg_estado`) AS val FROM `#__tb_municipio` AS m INNER JOIN `#__tb_estado` AS e ON e.`co_estado` = m.`co_estado` WHERE EXISTS (SELECT 1 FROM `#__tb_adesao` AS ad WHERE ad.`ds_municipios` IS NOT NULL AND ad.`ds_municipios` != '' AND FIND_IN_SET(m.`co_ibge`, ad.`ds_municipios`)) ORDER BY e.`sg_estado` ASC, m.`no_municipio` ASC"
            key_field="co"
            value_field="val"
            class="inputbox"
            onchange="this.form.submit();"
            layout="joomla.form.field.list-fancy-select"
            multiple="true"
            hint="COM_EDITAL_ADESOES_DS_MUNICIPIOS_FILTER"
        />
        <field
            name="no_consorcio"
            type="sql"
            label="COM_EDITAL_ADESOES_NO_CONSORCIO"
            query="SELECT `no_oficial` AS `nome`, `no_oficial` AS val FROM `#__tb_adesao` WHERE `tp_esfera_governamental` = 'consorcio' AND `state` IN (0, 1) AND `no_oficial` IS NOT NULL AND `no_oficial` != '' GROUP BY `no_oficial` ORDER BY `no_oficial` ASC"
            key_field="nome"
            value_field="val"
            class="inputbox"
            onchange="this.form.submit();"
            layout="joomla.form.field.list-fancy-select"
            multiple="true"
            hint="COM_EDITAL_ADESOES_NO_CONSORCIO_FILTER"
        />
        <field
            name="dt_criacao_de"
            type="calendar"
            label="COM_EDITAL_ADESOES_DT_CRIACAO_DE"
            format="%Y-%m-%d"
            filter="raw"
            translateformat="false"
            showtime="false"
            todaybutton="false"
            weeknumbers="false"
            filltable="false"
            class="inputbox"
            onchange="this.form.submit();"
            hint="COM_EDITAL_ADESOES_DT_CRIACAO_DE"
        />
        <field
            name="dt_criacao_ate"
            type="calendar"
            label="COM_EDITAL_ADESOES_DT_CRIACAO_ATE"
            format="%Y-%m-%d"
            filter="raw"
            translateformat="false"
            showtime="false"
            todaybutton="false"
            weeknumbers="false"
            filltable="false"
            class="inputbox"
            onchange="this.form.submit();"
            hint="COM_EDITAL_ADESOES_DT_CRIACAO_ATE"
        />


    </fields>

    <fields name="list">

        <field name="fullordering"
               type="list"
               label="COM_EDITAL_LIST_FULL_ORDERING"
               description="COM_EDITAL_LIST_FULL_ORDERING_DESC"
               onchange="this.form.submit();"
               default="a.id DESC"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.id ASC">COM_EDITAL_ID_ASC</option><option value="a.id DESC">COM_EDITAL_ID_DESC</option><option value="a.state ASC">COM_EDITAL_STATE_ASC</option><option value="a.state DESC">COM_EDITAL_STATE_DESC</option><option value="a.ordering ASC">COM_EDITAL_ORDERING_ASC</option><option value="a.ordering DESC">COM_EDITAL_ORDERING_DESC</option><option value="a.tp_esfera_governamental ASC">COM_EDITAL_TP_ESFERA_GOVERNAMENTAL_ASC</option><option value="a.tp_esfera_governamental DESC">COM_EDITAL_TP_ESFERA_GOVERNAMENTAL_DESC</option><option value="a.co_edital ASC">COM_EDITAL_CO_EDITAL_ASC</option><option value="a.co_edital DESC">COM_EDITAL_CO_EDITAL_DESC</option><option value="a.ds_cnpj ASC">COM_EDITAL_DS_CNPJ_ASC</option><option value="a.ds_cnpj DESC">COM_EDITAL_DS_CNPJ_DESC</option><option value="a.no_oficial ASC">COM_EDITAL_NO_OFICIAL_ASC</option><option value="a.no_oficial DESC">COM_EDITAL_NO_OFICIAL_DESC</option><option value="a.ds_email_responsavel ASC">COM_EDITAL_DS_EMAIL_RESPONSAVEL_ASC</option><option value="a.ds_email_responsavel DESC">COM_EDITAL_DS_EMAIL_RESPONSAVEL_DESC</option><option value="a.st_adesao ASC">COM_EDITAL_ST_ADESAO_ASC</option><option value="a.st_adesao DESC">COM_EDITAL_ST_ADESAO_DESC</option><option value="a.sg_estado ASC">COM_EDITAL_SG_ESTADO_ASC</option><option value="a.sg_estado DESC">COM_EDITAL_SG_ESTADO_DESC</option><option value="a.ds_municipios ASC">COM_EDITAL_DS_MUNICIPIOS_ASC</option><option value="a.ds_municipios DESC">COM_EDITAL_DS_MUNICIPIOS_DESC</option><option value="a.dt_criacao ASC">COM_EDITAL_DT_CRIACAO_ASC</option><option value="a.dt_criacao DESC">COM_EDITAL_DT_CRIACAO_DESC</option><option value="no_consorcio ASC">COM_EDITAL_NO_CONSORCIO_ASC</option><option value="no_consorcio DESC">COM_EDITAL_NO_CONSORCIO_DESC</option>

        </field>

       <field name="limit"
               type="limitbox"
               label="COM_EDITAL_LIST_LIMIT"
               description="COM_EDITAL_LIST_LIMIT_DESC"
               class="input-mini"
               default="25"
               onchange="this.form.submit();"
        />

    </fields>

</form>