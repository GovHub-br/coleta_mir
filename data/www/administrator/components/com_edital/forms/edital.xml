<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Comedital\Component\Edital\Administrator\Field">
  <fieldset>
    <field name="id" type="text" readonly="true" class="readonly" default="0" description="JGLOBAL_FIELD_ID_DESC"/>
    <field name="state" default="1" type="list" label="JSTATUS" description="JFIELD_PUBLISHED_DESC" class="inputbox" size="1">
      <option value="1">JPUBLISHED</option>
      <option value="0">JUNPUBLISHED</option>
      <option value="2">JARCHIVED</option>
      <option value="-2">JTRASHED</option>
    </field>
    <field name="ordering"/>
    <field name="checked_out" type="hidden" filter="unset"/>
    <field name="checked_out_time" type="hidden" filter="unset"/>
    <field name="created_by" type="createdby" default="0" label="JGLOBAL_FIELD_CREATED_BY_LABEL" description="JGLOBAL_FIELD_CREATED_BY_DESC" hidden="true" hint="COM_EDITAL_FORM_LBL_EDITAL_CREATED_BY"/>
    <field name="modified_by" type="modifiedby" default="0" label="JGLOBAL_FIELD_MODIFIED_BY_LABEL" description="JGLOBAL_FIELD_MODIFIED_BY_DESC" hidden="true" hint="COM_EDITAL_FORM_LBL_EDITAL_MODIFIED_BY"/>
    <field name="no_edital" filter="safehtml" type="text" required="true" label="COM_EDITAL_FORM_LBL_EDITAL_NO_EDITAL" description="COM_EDITAL_FORM_DESC_EDITAL_NO_EDITAL" hint="COM_EDITAL_FORM_LBL_EDITAL_NO_EDITAL"/>
    <field name="ds_edital" editor="tinymce" buttons="false" filter="\Joomla\CMS\Component\ComponentHelper::filterText" type="cadastroeditor" label="COM_EDITAL_FORM_LBL_EDITAL_DS_EDITAL" description="COM_EDITAL_FORM_DESC_EDITAL_DS_EDITAL" hint="COM_EDITAL_FORM_LBL_EDITAL_DS_EDITAL"/>
    <field name="dt_abertura" class="inputbox" format="%Y-%m-%d %H:%M:%S" timeformat="12" filter="server_utc" translateformat="false" showtime="true" singleheader="false" todaybutton="false" weeknumbers="false" filltable="false" type="calendar" label="COM_EDITAL_FORM_LBL_EDITAL_DT_ABERTURA" description="COM_EDITAL_FORM_DESC_EDITAL_DT_ABERTURA" hint="COM_EDITAL_FORM_LBL_EDITAL_DT_ABERTURA"/>
    <field name="dt_encerramento" class="inputbox" format="%Y-%m-%d %H:%M:%S" timeformat="12" filter="server_utc" translateformat="false" showtime="true" singleheader="false" todaybutton="false" weeknumbers="false" filltable="false" type="calendar" label="COM_EDITAL_FORM_LBL_EDITAL_DT_ENCERRAMENTO" description="COM_EDITAL_FORM_DESC_EDITAL_DT_ENCERRAMENTO" hint="COM_EDITAL_FORM_LBL_EDITAL_DT_ENCERRAMENTO"/>
    <field name="dt_publicacao" class="inputbox" format="%Y-%m-%d %H:%M:%S" timeformat="12" filter="server_utc" translateformat="false" showtime="true" singleheader="false" todaybutton="false" weeknumbers="false" filltable="false" type="calendar" label="COM_EDITAL_FORM_LBL_EDITAL_DT_PUBLICACAO" description="COM_EDITAL_FORM_DESC_EDITAL_DT_PUBLICACAO" hint="COM_EDITAL_FORM_LBL_EDITAL_DT_PUBLICACAO"/>
    <field name="tp_edital" type="list" label="COM_EDITAL_FORM_LBL_EDITAL_TP_EDITAL" description="COM_EDITAL_FORM_DESC_EDITAL_TP_EDITAL" default="adesao" required="true">
      <option value="adesao">Adesão</option>
      <option value="municipio_consorcio">Município dos Consórcios/Associações</option>
      <option value="formulario">Formulário</option>
    </field>
    <field name="tp_esfera_solicitante" type="list" required="false" default="" label="COM_EDITAL_FORM_LBL_EDITAL_TP_ESFERA_SOLICITANTE" description="COM_EDITAL_FORM_DESC_EDITAL_TP_ESFERA_SOLICITANTE">
      <option value="">COM_EDITAL_EDITAIS_TP_ESFERA_SOLICITANTE_OPTION_VAZIO</option>
      <option value="estadual">COM_EDITAL_EDITAIS_TP_ESFERA_SOLICITANTE_OPTION_ESTADUAL</option>
      <option value="municipal">COM_EDITAL_EDITAIS_TP_ESFERA_SOLICITANTE_OPTION_MUNICIPAL</option>
      <option value="consorcio">COM_EDITAL_EDITAIS_TP_ESFERA_SOLICITANTE_OPTION_CONSORCIO</option>
    </field>
    <field name="co_edital_adesao"
      type="sql"
      label="COM_EDITAL_FORM_LBL_EDITAL_CO_EDITAL_ADESAO"
      description="COM_EDITAL_FORM_DESC_EDITAL_CO_EDITAL_ADESAO"
      default=""
      required="false"
      query="SELECT 0 AS value, '- Selecione -' AS text UNION SELECT id AS value, CONCAT(id, ' - ', no_edital) AS text FROM #__tb_edital WHERE state != -2 ORDER BY text ASC"
      key_field="value"
      value_field="text"
      translate="false"/>
    <field name="version_note" type="text" label="JGLOBAL_FIELD_VERSION_NOTE_LABEL" description="JGLOBAL_FIELD_VERSION_NOTE_DESC" class="inputbox" size="45" labelclass="control-label"/>
    <field
      name="co_edital_municipio_consorcio"
      type="sql"
      label="COM_EDITAL_FORM_LBL_EDITAL_CO_EDITAL_MUNICIPIO_CONSORCIO"
      description="COM_EDITAL_FORM_DESC_EDITAL_CO_EDITAL_MUNICIPIO_CONSORCIO"
      default=""
      required="false"
      query="SELECT 0 AS value, '- Selecione -' AS text UNION SELECT id AS value, CONCAT(id, ' - ', no_edital) AS text FROM #__tb_edital WHERE state != -2 ORDER BY text ASC"
      key_field="value"
      value_field="text"
      translate="false"/>
    <field name="ds_versao" filter="safehtml" type="text" required="false" label="COM_EDITAL_FORM_LBL_EDITAL_DS_VERSAO" description="COM_EDITAL_FORM_DESC_EDITAL_DS_VERSAO" hint="COM_EDITAL_FORM_LBL_EDITAL_DS_VERSAO"/>
  </fieldset>
</form>
